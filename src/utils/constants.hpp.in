#pragma once

#include <iostream>
#include <vector>
#include <complex>
#include <unordered_map>
#include <array>
#include <string_view>

#include "utils/helpers/environment.hpp"

namespace cunqa {

// Helper function to obtain the dynamic directory of CUNQA files storage
inline std::string get_cunqa_path() { return get_env_variable("STORE") + "/.cunqa"; }

inline const std::string INSTALL_PATH = "@CMAKE_INSTALL_PREFIX@";
// Registry directories, see utils/registry.hpp
inline const std::string QPUS_DIR = get_cunqa_path() + "/qpus";
inline const std::string COMM_DIR = get_cunqa_path() + "/communications";

inline constexpr std::array<std::string_view, 7> SUPPORTED_SIMPLE_SIMULATORS = {"Aer", "Cunqa", "Munich", "Maestro", "Qsim", "Quest", "Qulacs"};
inline constexpr std::array<std::string_view, 7> SUPPORTED_CC_SIMULATORS = {"Aer", "Cunqa", "Munich", "Maestro", "Qsim", "Quest", "Qulacs"};
inline constexpr std::array<std::string_view, 7> SUPPORTED_QC_SIMULATORS = {"Aer", "Cunqa", "Munich", "Maestro", "Qsim", "Quest", "Qulacs"};
inline constexpr std::array<std::string_view, 2> SUPPORTED_NOISY_SIMULATORS = {"Aer", "Munich"};

} // End namespace cunqa