{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "cunqa_config_file",
    "title": "CunqaConfigFile",
    "description": "Json schema to specify the characteristics of each deployed QPU",
    "type": "object",
    "properties": 
    {
                "name": 
                {
                    "description":"Name of the QPU backend",
                    "type":"string",
                    "default": "DefaultBackend"
                },
                "version":
                {
                    "description":"Specific version of the QPU backend",
                    "type":"string",
                    "default": "0.0.0"
                },
                "description":
                {
                    "description":"Description of the QPU backend",
                    "type":"string",
                    "default": "Default backend"
                },
                "url":
                {
                    "description":"Url",
                    "type":"string",
                    "default":""
                },
                "num_qubits":
                {
                    "description":"Number of qubits of the QPU",
                    "type":"integer",
                    "default": 15
                },
                "is_simulator":
                {
                    "description":"",
                    "type":"boolean",
                    "default": true
                },
                "conditional":
                {
                    "description":"",
                    "type":"boolean",
                    "default": true
                },
                "memory":
                {
                    "description":"",
                    "type":"boolean",
                    "default": true
                },
                "max_shots":
                {
                    "description":"Maximum allowed shots",
                    "type":"integer",
                    "default": 1000000
                },
                "coupling_map":
                {   
                    "description":"Topology of the QPU's qubits",
                    "type":"array",
                    "items":
                    {
                        "type":"array",
                        "items":
                        {
                            "type":"integer"
                        }
                    }
                },
                "basis_gates":
                {
                    "description":"List of native gates admited by the QPU",
                    "type":"array",
                    "items":
                    {
                        "type": "string"
                    }
                },
                "custom_instructions":
                {
                    "description":"",
                    "type":"string"
                },
                "gates":
                {
                    "description":"",
                    "type":"array",
                    "items":
                    {
                        "type": "string"
                    }
                },
                "timing":
                {
                    "description":"Simulated time model of the vQPU. Durations are in nanoseconds. If absent, the vQPU runs on wall-clock time only.",
                    "type":"object",
                    "properties":
                    {
                        "one_qubit_gate": {"type":"number", "minimum":0, "default":50},
                        "multi_qubit_gate": {"type":"number", "minimum":0, "default":300},
                        "measure": {"type":"number", "minimum":0, "default":1000},
                        "reset": {"type":"number", "minimum":0, "default":1000},
                        "classical_latency": {"type":"number", "minimum":0, "default":0},
                        "entanglement": {"type":"number", "minimum":0, "default":0},
                        "gate_durations":
                        {
                            "description":"Per-instruction duration overrides, by instruction name.",
                            "type":"object",
                            "additionalProperties": {"type":"number", "minimum":0}
                        }
                    },
                    "additionalProperties": false
                }
            }

}
